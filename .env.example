# ============================================================================
#  REQUIRED
# ============================================================================
# From @BotFather in Telegram.
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# ============================================================================
#  Database
# ============================================================================
# SQLite is fine for a single-user or small deployment.
DATABASE_URL=sqlite+aiosqlite:///./marketbot.db
# PostgreSQL (uncomment asyncpg in requirements.txt first):
# DATABASE_URL=postgresql+asyncpg://marketbot:marketbot@localhost:5432/marketbot
DB_ECHO=false
# How long a SQLite writer waits for the lock before failing. The library default
# is 5s, which is shorter than a single rate-limited Steam fetch.
SQLITE_BUSY_TIMEOUT=30

# ============================================================================
#  Steam rate limiting  -- the settings that keep you un-throttled
# ============================================================================
# Steam allows roughly 20 requests/minute per IP. Staying under it is the whole
# game; 18 leaves headroom for retries. Raising this WILL get you 429s.
STEAM_RATE_PER_MIN=18
# Burst allowance. Small on purpose: bursts trip the ceiling even when the
# average rate looks safe.
STEAM_BURST=5
STEAM_TIMEOUT=20
STEAM_MAX_RETRIES=3
# 429 gets its own, far smaller budget than network errors. Retrying a rate-limit
# in-place holds the single refresh worker for minutes; requeueing is better.
STEAM_THROTTLE_RETRIES=1
# The governor will not cut the rate below this, however many 429s it sees.
STEAM_MIN_RATE_PER_MIN=3
STEAM_CURRENCY=USD
STEAM_DEFAULT_APPID=730
# Seconds to reuse a response for; collapses duplicate concurrent lookups.
STEAM_CACHE_TTL=60
# Optional outbound proxy, e.g. http://user:pass@host:port
# STEAM_PROXY=

# Optional. The value of your steamLoginSecure cookie. Only unlocks
# /market/pricehistory, used to backfill a chart when an item is first added.
# Everything else works without it. Treat it like a password.
# STEAM_LOGIN_SECURE=

# Circuit breaker: consecutive failures before an endpoint is cut off, and how
# long the first cooldown lasts (it doubles on each subsequent trip).
CB_FAILURE_THRESHOLD=3
CB_BASE_COOLDOWN=60
CB_MAX_COOLDOWN=1800

# ============================================================================
#  Scheduler
# ============================================================================
ENABLE_SCHEDULER=true
REFRESH_HOT_SECONDS=120
REFRESH_WARM_SECONDS=1200
REFRESH_COLD_SECONDS=21600
REFRESH_BATCH_HOT=40
REFRESH_BATCH_WARM=80
REFRESH_BATCH_COLD=120
# Raw snapshots older than this are pruned; daily OHLCV rollups are kept forever.
RAW_RETENTION_DAYS=90

# ============================================================================
#  Alerts
# ============================================================================
ALERTS_ENABLED=true
ALERT_MAX_PER_USER_HOUR=20
ALERT_DEFAULT_COOLDOWN_MIN=60
# A threshold rule must recover past its threshold by this margin before it can
# fire again - stops a price sitting on the line from alerting forty times.
ALERT_HYSTERESIS_PCT=2.0
MAX_WATCHLIST_PER_USER=50
MAX_RULES_PER_USER=100

# ============================================================================
#  Telegram delivery
# ============================================================================
TG_GLOBAL_RATE=25
TG_PER_CHAT_INTERVAL=1.05

# ============================================================================
#  Mini App (optional)
# ============================================================================
# Telegram only loads Mini Apps over HTTPS on a public URL.
WEBAPP_ENABLED=false
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
WEBAPP_PUBLIC_URL=

# ============================================================================
#  Misc
# ============================================================================
LOG_LEVEL=INFO
# Telegram message format. HTML is what every screen in this bot is written in.
PARSE_MODE=HTML
LOG_JSON=false
# Where rendered chart PNGs are written.
CHART_DIR=./var/charts
# Rotating log file. Leave unset when running in a terminal or a container (where
# stdout is captured); set it when running as a background service, which has
# nowhere to print.
# LOG_FILE=./var/marketbot.log
LOG_MAX_BYTES=5000000
LOG_BACKUPS=5
# Exclusive lock that stops a second copy polling the same token.
LOCK_FILE=./var/marketbot.lock
# Comma-separated Telegram user ids with access to extra /status detail.
ADMIN_IDS=

# ============================================================================
#  Hosting  (see DEPLOYMENT.md)
# ============================================================================
# Most platforms inject PORT and kill a process that does not bind it.
PORT=8080
# Serves GET /healthz, /ping and /. Keep on when hosted; harmless locally.
HEALTH_ENABLED=true
HEALTH_HOST=0.0.0.0

# Webhook mode. Leave off for local use and for any host where polling works --
# polling needs no public URL. Webhooks use less CPU on a constrained free instance.
WEBHOOK_ENABLED=false
# The public https:// URL of this service, no trailing path.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
# Telegram echoes this back in a header. It is the only thing stopping anyone who
# learns your webhook URL from posting fake updates. Generate a long random string.
WEBHOOK_SECRET=

# Per-user inbound throttle: at most THROTTLE_BURST updates in any
# (THROTTLE_RATE * THROTTLE_BURST) second window.
THROTTLE_RATE=0.3
THROTTLE_BURST=10
